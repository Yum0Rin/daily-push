# ===== 敏感信息：绝不提交 =====
# 各平台 Cookie / 会话凭证
config.json

# 采集存储（含个人/群消息内容）
data/

# 导出的静态站点（由 export_site.py 生成，单独 push 到 Pages）
site/

# 运行日志（可能含 URL/路径等细节）
*.log

# ===== 环境 / 缓存 =====
__pycache__/
*.pyc
node_modules/

# 本地运行痕迹
.netease_api_tmp/
.pytest_cache/

# 云端采集状态（Actions 每次运行生成）
cloud_status.json

# 操作系统
.DS_Store
Thumbs.db

# ===== 开发工具脚本（可留本地，视需求）=====
tools/xhs_console.txt
tools/xhs_capture.txt
