  "wechat": {
    "important_biz": [],
    "exclude_keywords": ["演出余票监控", "省教育厅", "三福sanfu"],
    "notify_keywords": ["提醒", "通知", "签收", "到账", "取餐", "下单", "已支付", "排队", "发货", "日报", "账单", "领取", "优惠券"],
